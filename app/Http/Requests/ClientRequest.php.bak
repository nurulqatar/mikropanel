<?php

namespace App\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

class ClientRequest extends FormRequest
{
    public function authorize(): bool
    {
        return true;
    }

    public function rules(): array
    {
        return [

            'router_id' => [
                'required',
                'exists:routers,id',
            ],

            'ip_range_id' => [
                'required',
                'exists:ip_ranges,id',
            ],

            'package_id' => [
                'required',
                'exists:packages,id',
            ],

            'name' => [
                'required',
                'string',
                'max:100',
            ],

            'mac_address' => [
                'required',
                'regex:/^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/',
                Rule::unique('clients', 'mac_address')
                    ->ignore($this->client),
            ],

            'phone' => [
                'nullable',
                'string',
                'max:30',
            ],

            'email' => [
                'nullable',
                'email',
                'max:100',
            ],

            'address' => [
                'nullable',
                'string',
                'max:500',
            ],

            'expiry_date' => [
                'nullable',
                'date',
            ],

            'installed_at' => [
                'nullable',
                'date',
            ],

            'billing_day' => [
                'required',
                'integer',
                'between:1,31',
            ],

            'enabled' => [
                'boolean',
            ],
        ];
    }

    public function messages(): array
    {
        return [

            'router_id.required' => 'Please select a router.',

            'ip_range_id.required' => 'Please select an IP Range.',

            'package_id.required' => 'Please select a package.',

            'name.required' => 'Client name is required.',

            'mac_address.required' => 'MAC Address is required.',

            'mac_address.regex' => 'MAC Address format must be AA:BB:CC:DD:EE:FF',

            'mac_address.unique' => 'This MAC Address already exists.',

            'billing_day.required' => 'Billing day is required.',

            'billing_day.between' => 'Billing day must be between 1 and 31.',
        ];
    }
}
