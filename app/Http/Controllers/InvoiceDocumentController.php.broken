<?php

namespace App\Http\Controllers;

use App\Models\Invoice;
use App\Models\Payment;
use Barryvdh\DomPDF\Facade\Pdf;
use Illuminate\Support\Collection;
use Illuminate\Support\Str;
use Illuminate\View\View;
use Symfony\Component\HttpFoundation\Response;

class InvoiceDocumentController extends Controller
{
    public function print(Invoice $invoice): View
    {
        $invoices = $this->getInvoices($invoice);

        return view('invoices.document', [
            'invoices' => $invoices,
            'paymentsByInvoice' => $this->getPayments($invoices),
            'pdfMode' => false,
            'documentTitle' => $invoice->invoice_no,
        ]);
    }

    public function download(Invoice $invoice): Response
    {
        $invoices = $this->getInvoices($invoice);

])
    ->setPaper('a4', 'portrait')
    ->setOption('dpi', 96)
    ->setOption('defaultFont', 'DejaVu Sans')
    ->setOption('isHtml5ParserEnabled', true);
        $fileName = Str::slug(
            $invoice->invoice_no ?: 'invoice-' . $invoice->id
        ) . '.pdf';

        return $pdf->download($fileName);
    }

    public function printAll(): View
    {
        $invoices = $this->getInvoices();

        return view('invoices.document', [
            'invoices' => $invoices,
            'paymentsByInvoice' => $this->getPayments($invoices),
            'pdfMode' => false,
            'documentTitle' => 'All Invoices',
        ]);
    }

    public function downloadAll(): Response
    {
        $invoices = $this->getInvoices();

])
    ->setPaper('a4', 'portrait')
    ->setOption('dpi', 96)
    ->setOption('defaultFont', 'DejaVu Sans')
    ->setOption('isHtml5ParserEnabled', true);
        return $pdf->download(
            'genius-invoices-' . today()->format('Y-m-d') . '.pdf'
        );
    }

    private function getInvoices(
        ?Invoice $invoice = null
    ): Collection {
        $query = Invoice::query()
            ->with([
                'client.package',
            ]);

        if ($invoice) {
            return $query
                ->whereKey($invoice->id)
                ->get();
        }

        return $query
            ->orderByDesc('issue_date')
            ->orderByDesc('id')
            ->get();
    }

    private function getPayments(
        Collection $invoices
    ): Collection {
        if ($invoices->isEmpty()) {
            return collect();
        }

        return Payment::query()
            ->whereIn(
                'invoice_id',
                $invoices->pluck('id')
            )
            ->orderBy('payment_date')
            ->orderBy('id')
            ->get()
            ->groupBy('invoice_id');
    }
}
