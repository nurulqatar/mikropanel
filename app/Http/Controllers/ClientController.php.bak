<?php

namespace App\Http\Controllers;

use App\Http\Requests\ClientRequest;
use App\Models\Client;
use App\Models\IpRange;
use App\Models\Package;
use App\Models\Router;
use App\Services\ClientProvisionService;
use App\Services\IpAllocatorService;
use Illuminate\Http\RedirectResponse;
use Inertia\Inertia;
use Inertia\Response;

class ClientController extends Controller
{
    public function index(): Response
    {
        return Inertia::render('Clients/Index', [
            'clients' => Client::with([
                'router',
                'package',
                'ipRange',
            ])->latest()->get(),
        ]);
    }

    public function create(): Response
    {
        return Inertia::render('Clients/Create', [

            'routers' => Router::where('enabled', true)
                ->orderBy('name')
                ->get([
                    'id',
                    'name',
                ]),

            'packages' => Package::where('enabled', true)
                ->orderBy('name')
                ->get([
                    'id',
                    'name',
                    'speed_download',
                    'speed_upload',
                    'mikrotik_profile',
                ]),

            'ipRanges' => IpRange::where('enabled', true)
                ->orderBy('name')
                ->get([
                    'id',
                    'router_id',
                    'name',
                    'network',
                    'gateway',
                    'start_ip',
                    'end_ip',
                ]),
        ]);
    }

    public function store(
        ClientRequest $request,
        IpAllocatorService $allocator,
        ClientProvisionService $provision
    ): RedirectResponse {

        $data = $request->validated();

        $range = IpRange::findOrFail($data['ip_range_id']);

        $ip = $allocator->allocate($range);

        if (!$ip) {
            return back()
                ->withErrors([
                    'ip_range_id' => 'No free IP available in this IP Range.',
                ])
                ->withInput();
        }

        $data['ip_address'] = $ip;

        $lastId = Client::max('id') ?? 0;

        $data['client_code'] = 'CLI-' .
            str_pad($lastId + 1, 5, '0', STR_PAD_LEFT);

        $client = Client::create($data);

        $provision->provision($client);

        return redirect()
            ->route('clients.index')
            ->with(
                'success',
                "Client created successfully with IP {$ip}"
            );
    }

public function show(Client $client): Response
{
    $client->load([
        'router',
        'package',
        'ipRange',

        'invoices' => function ($query) {
            $query
                ->orderByDesc('issue_date')
                ->orderByDesc('id');
        },

        'payments' => function ($query) {
            $query
                ->with('invoice:id,invoice_no')
                ->orderByDesc('payment_date')
                ->orderByDesc('id');
        },
    ]);

    $totalBilled = $client->invoices->sum(function ($invoice) {
        return (float) $invoice->amount
            - (float) $invoice->discount;
    });

    return Inertia::render('Clients/Show', [
        'client' => $client,

        'billingSummary' => [
            'invoice_count' => $client->invoices->count(),

            'total_billed' => $totalBilled,

            'total_paid' => (float) $client->payments
                ->sum('amount'),

            'total_due' => (float) $client->invoices
                ->sum('due_amount'),
        ],
    ]);
}


    public function edit(Client $client): Response
    {
        return Inertia::render('Clients/Edit', [

            'client' => $client,

            'routers' => Router::orderBy('name')
                ->get([
                    'id',
                    'name',
                ]),

            'packages' => Package::orderBy('name')
                ->get([
                    'id',
                    'name',
                    'speed_download',
                    'speed_upload',
                    'mikrotik_profile',
                ]),

            'ipRanges' => IpRange::orderBy('name')
                ->get([
                    'id',
                    'router_id',
                    'name',
                    'network',
                    'gateway',
                    'start_ip',
                    'end_ip',
                ]),
        ]);
    }

    public function update(
        ClientRequest $request,
        Client $client,
        ClientProvisionService $provision
    ): RedirectResponse {

        $client->update(
            $request->validated()
        );

        $provision->update($client);

        return redirect()
            ->route('clients.index')
            ->with(
                'success',
                'Client updated successfully.'
            );
    }

    public function suspend(
        Client $client,
        ClientProvisionService $provision
    ): RedirectResponse {

        $provision->suspend($client);

        return back()->with(
            'success',
            'Client suspended successfully.'
        );
    }

    public function unsuspend(
        Client $client,
        ClientProvisionService $provision
    ): RedirectResponse {

        $provision->unsuspend($client);

        return back()->with(
            'success',
            'Client activated successfully.'
        );
    }

    public function destroy(
        Client $client,
        ClientProvisionService $provision
    ): RedirectResponse {

        $provision->remove($client);

        $client->delete();

        return back()->with(
            'success',
            'Client deleted successfully.'
        );
    }
}
