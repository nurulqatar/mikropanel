import { Link, usePage } from '@inertiajs/react';
import {
    HomeIcon,
    UsersIcon,
    ServerStackIcon,
    CubeIcon,
    GlobeAltIcon,
    DocumentTextIcon,
    CreditCardIcon,
    BanknotesIcon,
    Cog6ToothIcon,
} from '@heroicons/react/24/outline';

const navigation = [
    { name: 'Dashboard', route: 'dashboard', icon: HomeIcon },
    { name: 'Clients', route: 'clients.index', icon: UsersIcon },
    { name: 'Routers', route: 'routers.index', icon: ServerStackIcon },
    { name: 'Packages', route: 'packages.index', icon: CubeIcon },
    { name: 'IP Pools', route: 'ip-ranges.index', icon: GlobeAltIcon },
    { name: 'Invoices', route: 'invoices.index', icon: DocumentTextIcon },
    { name: 'Payments', route: 'payments.index', icon: CreditCardIcon },
    { name: 'Expenses', route: 'expenses.index', icon: BanknotesIcon },
    { name: 'Settings', route: 'profile.edit', icon: Cog6ToothIcon },
];

export default function Sidebar() {
    const { url } = usePage();

    return (
        <aside className="flex h-screen w-72 flex-col bg-slate-900 text-white shadow-xl">
            <div className="border-b border-slate-700 px-6 py-6">
                <h1 className="text-2xl font-bold tracking-wide text-cyan-400">
                    MikroPanel
                </h1>

                <p className="mt-1 text-sm text-slate-400">
                    ISP Billing System
                </p>
            </div>

            <nav className="flex-1 space-y-2 p-4">
                {navigation.map((item) => {
                    const Icon = item.icon;

                    const active =
                        url === route(item.route) ||
                        url.startsWith('/' + item.route.split('.')[0]);

                    return (
                        <Link
                            key={item.route}
                            href={route(item.route)}
                            className={`flex items-center gap-3 rounded-xl px-4 py-3 transition-all duration-200 ${
                                active
                                    ? 'bg-cyan-600 text-white shadow-lg'
                                    : 'text-slate-300 hover:bg-slate-800 hover:text-white'
                            }`}
                        >
                            <Icon className="h-6 w-6" />

                            <span className="font-medium">
                                {item.name}
                            </span>
                        </Link>
                    );
                })}
            </nav>

            <div className="border-t border-slate-700 p-4">
                <div className="rounded-xl bg-slate-800 p-4">
                    <p className="text-xs uppercase tracking-wider text-slate-400">
                        Version
                    </p>

                    <p className="mt-1 font-semibold text-cyan-400">
                        MikroPanel v1.0
                    </p>
                </div>
            </div>
        </aside>
    );
}
