import AppLayout from '@/Layouts/AppLayout';
import { Head, Link, useForm } from '@inertiajs/react';

export default function Create({
    routers,
    packages,
    ipRanges,
}) {

    const {
        data,
        setData,
        post,
        processing,
        errors,
    } = useForm({

        router_id: '',
        ip_range_id: '',
        package_id: '',

        name: '',
        mac_address: '',

        phone: '',
        email: '',
        address: '',

        expiry_date: '',
        installed_at: '',

        billing_day: 1,

        enabled: true,
    });


    const submit = (e) => {
        e.preventDefault();
        post(route('clients.store'));
    };


    const filteredRanges = ipRanges.filter(
        range =>
            String(range.router_id) ===
            String(data.router_id)
    );


    const input =
        "w-full rounded-lg border-slate-300 px-4 py-3 shadow-sm focus:border-cyan-500 focus:ring-cyan-500";


    return (

        <AppLayout>

            <Head title="Add Client" />


            <div className="space-y-6">


                <div>
                    <h1 className="text-3xl font-bold text-slate-800">
                        Add New Client
                    </h1>

                    <p className="text-slate-500">
                        Create ISP customer account
                    </p>
                </div>



                <form
                    onSubmit={submit}
                    className="space-y-6"
                >



                    <div className="rounded-xl bg-white p-6 shadow">


                        <h2 className="mb-5 text-xl font-bold">
                            🌐 Network Configuration
                        </h2>


                        <div className="grid gap-5 md:grid-cols-2">


                            <div>

                                <label>
                                    Router
                                </label>

                                <select
                                    className={input}
                                    value={data.router_id}
                                    onChange={e => {

                                        setData(
                                            'router_id',
                                            e.target.value
                                        );

                                        setData(
                                            'ip_range_id',
                                            ''
                                        );

                                    }}
                                >

                                    <option value="">
                                        Select Router
                                    </option>


                                    {routers.map(router => (

                                        <option
                                            key={router.id}
                                            value={router.id}
                                        >
                                            {router.name}
                                        </option>

                                    ))}


                                </select>

                                <p className="text-red-500 text-sm">
                                    {errors.router_id}
                                </p>

                            </div>



                            <div>

                                <label>
                                    IP Range
                                </label>


                                <select
                                    className={input}
                                    value={data.ip_range_id}
                                    onChange={
                                        e =>
                                        setData(
                                            'ip_range_id',
                                            e.target.value
                                        )
                                    }
                                >

                                    <option value="">
                                        Select IP Range
                                    </option>


                                    {filteredRanges.map(range => (

                                        <option
                                            key={range.id}
                                            value={range.id}
                                        >
                                            {range.name}
                                        </option>

                                    ))}


                                </select>


                                <p className="text-red-500 text-sm">
                                    {errors.ip_range_id}
                                </p>


                            </div>



                        </div>


                    </div>




                    <div className="rounded-xl bg-white p-6 shadow">


                        <h2 className="mb-5 text-xl font-bold">
                            👤 Client Information
                        </h2>


                        <div className="grid gap-5 md:grid-cols-2">


                            <div>
                                <label>
                                    Client Name
                                </label>

                                <input
                                    className={input}
                                    value={data.name}
                                    onChange={
                                        e =>
                                        setData(
                                            'name',
                                            e.target.value
                                        )
                                    }
                                />

                                <p className="text-red-500 text-sm">
                                    {errors.name}
                                </p>

                            </div>



                            <div>

                                <label>
                                    Package
                                </label>


                                <select
                                    className={input}
                                    value={data.package_id}
                                    onChange={
                                        e =>
                                        setData(
                                            'package_id',
                                            e.target.value
                                        )
                                    }
                                >

                                    <option value="">
                                        Select Package
                                    </option>


                                    {packages.map(pkg => (

                                        <option
                                            key={pkg.id}
                                            value={pkg.id}
                                        >
                                            {pkg.name}
                                        </option>

                                    ))}


                                </select>


                            </div>



                            <div>

                                <label>
                                    MAC Address
                                </label>


                                <input
                                    className={input}
                                    placeholder="AA:BB:CC:DD:EE:FF"
                                    value={data.mac_address}
                                    onChange={
                                        e =>
                                        setData(
                                            'mac_address',
                                            e.target.value
                                        )
                                    }
                                />


                                <p className="text-red-500 text-sm">
                                    {errors.mac_address}
                                </p>


                            </div>




                            <div>

                                <label>
                                    Phone
                                </label>

                                <input
                                    className={input}
                                    value={data.phone}
                                    onChange={
                                        e =>
                                        setData(
                                            'phone',
                                            e.target.value
                                        )
                                    }
                                />

                            </div>



                            <div>

                                <label>
                                    Email
                                </label>

                                <input
                                    className={input}
                                    type="email"
                                    value={data.email}
                                    onChange={
                                        e =>
                                        setData(
                                            'email',
                                            e.target.value
                                        )
                                    }
                                />

                            </div>



                            <div>

                                <label>
                                    Billing Day
                                </label>

                                <input
                                    className={input}
                                    type="number"
                                    min="1"
                                    max="31"
                                    value={data.billing_day}
                                    onChange={
                                        e =>
                                        setData(
                                            'billing_day',
                                            e.target.value
                                        )
                                    }
                                />

                            </div>


                        </div>


                        <div className="mt-5">


                            <label>
                                Address
                            </label>


                            <textarea
                                className={input}
                                rows="3"
                                value={data.address}
                                onChange={
                                    e =>
                                    setData(
                                        'address',
                                        e.target.value
                                    )
                                }
                            />


                        </div>


                    </div>





                    <div className="rounded-xl bg-white p-6 shadow">


                        <h2 className="mb-5 text-xl font-bold">
                            ⚙️ Account Settings
                        </h2>



                        <div className="grid gap-5 md:grid-cols-2">


                            <input
                                type="date"
                                className={input}
                                value={data.installed_at}
                                onChange={
                                    e =>
                                    setData(
                                        'installed_at',
                                        e.target.value
                                    )
                                }
                            />


                            <input
                                type="date"
                                className={input}
                                value={data.expiry_date}
                                onChange={
                                    e =>
                                    setData(
                                        'expiry_date',
                                        e.target.value
                                    )
                                }
                            />


                        </div>


                        <label className="mt-5 flex items-center gap-3">

                            <input
                                type="checkbox"
                                checked={data.enabled}
                                onChange={
                                    e =>
                                    setData(
                                        'enabled',
                                        e.target.checked
                                    )
                                }
                            />

                            Active Client

                        </label>


                    </div>





                    <div className="flex gap-3">


                        <button
                            disabled={processing}
                            className="rounded-lg bg-cyan-600 px-6 py-3 text-white shadow hover:bg-cyan-700"
                        >
                            Save Client
                        </button>


                        <Link
                            href={route('clients.index')}
                            className="rounded-lg bg-slate-500 px-6 py-3 text-white"
                        >
                            Cancel
                        </Link>


                    </div>



                </form>


            </div>


        </AppLayout>

    );
}
