import AppLayout from '@/Layouts/AppLayout';
import { Head, Link, useForm } from '@inertiajs/react';

export default function Edit({
    client,
    routers,
    packages,
}) {

    const {
        data,
        setData,
        put,
        processing,
        errors,
    } = useForm({

        router_id: client.router_id ?? '',
        ip_range_id: client.ip_range_id ?? '',
        package_id: client.package_id ?? '',

        name: client.name ?? '',
        mac_address: client.mac_address ?? '',

        phone: client.phone ?? '',
        email: client.email ?? '',
        address: client.address ?? '',

        expiry_date: client.expiry_date
            ? client.expiry_date.substring(0,10)
            : '',

        billing_day: client.billing_day ?? 1,

        enabled: client.enabled ?? true,

    });


    const submit = (e) => {

        e.preventDefault();

        put(
            route(
                'clients.update',
                client.id
            )
        );

    };


    return (

        <AppLayout title="Edit Client">

            <Head title="Edit Client" />


            <div className="space-y-6">


                <div>

                    <h1 className="text-3xl font-bold text-slate-800">
                        Edit Client
                    </h1>

                    <p className="text-slate-500">
                        Update customer information
                    </p>

                </div>



                <div className="rounded-xl bg-white p-6 shadow">


                    <form
                        onSubmit={submit}
                        className="space-y-5"
                    >



                        <div className="grid gap-5 md:grid-cols-2">


                            <div>

                                <label className="mb-1 block">
                                    Router
                                </label>

                                <select
                                    className="w-full rounded border"
                                    value={data.router_id}
                                    onChange={(e)=>
                                        setData(
                                            'router_id',
                                            e.target.value
                                        )
                                    }
                                >

                                    {routers.map(router=>(

                                        <option
                                            key={router.id}
                                            value={router.id}
                                        >
                                            {router.name}
                                        </option>

                                    ))}

                                </select>

                                <p className="text-sm text-red-600">
                                    {errors.router_id}
                                </p>

                            </div>




                            <div>

                                <label className="mb-1 block">
                                    Package
                                </label>


                                <select
                                    className="w-full rounded border"
                                    value={data.package_id}
                                    onChange={(e)=>
                                        setData(
                                            'package_id',
                                            e.target.value
                                        )
                                    }
                                >

                                    {packages.map(pkg=>(

                                        <option
                                            key={pkg.id}
                                            value={pkg.id}
                                        >
                                            {pkg.name}
                                        </option>

                                    ))}

                                </select>


                                <p className="text-sm text-red-600">
                                    {errors.package_id}
                                </p>


                            </div>


                        </div>




                        <div>

                            <label className="mb-1 block">
                                Client Name
                            </label>


                            <input
                                className="w-full rounded border"
                                value={data.name}
                                onChange={(e)=>
                                    setData(
                                        'name',
                                        e.target.value
                                    )
                                }
                            />


                            <p className="text-sm text-red-600">
                                {errors.name}
                            </p>

                        </div>





                        <div className="grid gap-5 md:grid-cols-2">


                            <div>

                                <label className="mb-1 block">
                                    MAC Address
                                </label>


                                <input
                                    className="w-full rounded border"
                                    value={data.mac_address}
                                    placeholder="AA:BB:CC:DD:EE:FF"
                                    onChange={(e)=>
                                        setData(
                                            'mac_address',
                                            e.target.value
                                        )
                                    }
                                />

                                <p className="text-sm text-red-600">
                                    {errors.mac_address}
                                </p>


                            </div>




                            <div>

                                <label className="mb-1 block">
                                    Phone
                                </label>


                                <input
                                    className="w-full rounded border"
                                    value={data.phone}
                                    onChange={(e)=>
                                        setData(
                                            'phone',
                                            e.target.value
                                        )
                                    }
                                />

                            </div>


                        </div>





                        <div className="grid gap-5 md:grid-cols-2">


                            <div>

                                <label className="mb-1 block">
                                    Email
                                </label>


                                <input
                                    type="email"
                                    className="w-full rounded border"
                                    value={data.email}
                                    onChange={(e)=>
                                        setData(
                                            'email',
                                            e.target.value
                                        )
                                    }
                                />


                            </div>



                            <div>

                                <label className="mb-1 block">
                                    Billing Day
                                </label>


                                <input
                                    type="number"
                                    min="1"
                                    max="31"
                                    className="w-full rounded border"
                                    value={data.billing_day}
                                    onChange={(e)=>
                                        setData(
                                            'billing_day',
                                            e.target.value
                                        )
                                    }
                                />

                            </div>


                        </div>





                        <div>

                            <label className="mb-1 block">
                                Address
                            </label>


                            <textarea

                                rows="3"

                                className="w-full rounded border"

                                value={data.address}

                                onChange={(e)=>
                                    setData(
                                        'address',
                                        e.target.value
                                    )
                                }

                            />

                        </div>






                        <div>

                            <label className="mb-1 block">
                                Expiry Date
                            </label>


                            <input

                                type="date"

                                className="w-full rounded border"

                                value={data.expiry_date}

                                onChange={(e)=>
                                    setData(
                                        'expiry_date',
                                        e.target.value
                                    )
                                }

                            />


                        </div>





                        <div className="flex items-center gap-3">


                            <input

                                type="checkbox"

                                checked={data.enabled}

                                onChange={(e)=>
                                    setData(
                                        'enabled',
                                        e.target.checked
                                    )
                                }

                            />


                            <span>
                                Client Active
                            </span>


                        </div>





                        <div className="flex gap-3">


                            <button

                                disabled={processing}

                                className="rounded-lg bg-cyan-600 px-5 py-2 text-white"

                            >

                                Update Client

                            </button>



                            <Link

                                href={route('clients.index')}

                                className="rounded-lg bg-slate-600 px-5 py-2 text-white"

                            >

                                Cancel

                            </Link>


                        </div>



                    </form>


                </div>


            </div>


        </AppLayout>

    );

}
