import AppLayout from '@/Layouts/AppLayout';
import {
    Head,
    Link,
    router,
    useForm,
} from '@inertiajs/react';
import { useState } from 'react';

export default function Index({ clients }) {
    const [search, setSearch] = useState('');
    const [filter, setFilter] = useState('all');
    const [renewClient, setRenewClient] = useState(null);

    const {
        data,
        setData,
        post,
        processing,
        errors,
        reset,
        clearErrors,
    } = useForm({
        payment_method: 'Cash',
        transaction_id: '',
        notes: '',
    });

    const paymentMethods = [
        'Cash',
        'Bank Transfer',
        'bKash',
        'Nagad',
        'Rocket',
        'Upay',
        'Ooredoo Money',
        'iPay',
        'Stripe',
        'PayPal',
        'Manual Adjustment',
    ];

    const openRenewModal = (client) => {
        clearErrors();
        reset();
        setRenewClient(client);
    };

    const closeRenewModal = () => {
        if (processing) {
            return;
        }

        setRenewClient(null);
        clearErrors();
        reset();
    };

    const submitRenewal = (event) => {
        event.preventDefault();

        if (!renewClient) {
            return;
        }

        post(route('clients.renew', renewClient.id), {
            preserveScroll: true,

            onSuccess: () => {
                setRenewClient(null);
                clearErrors();
                reset();
            },
        });
    };

    const suspendClient = (id) => {
        if (confirm('Suspend this client?')) {
            router.post(
                route('clients.suspend', id),
                {},
                {
                    preserveScroll: true,
                },
            );
        }
    };

    const activateClient = (id) => {
        if (confirm('Activate this client?')) {
            router.post(
                route('clients.unsuspend', id),
                {},
                {
                    preserveScroll: true,
                },
            );
        }
    };

    const deleteClient = (id) => {
        if (confirm('Delete this client permanently?')) {
            router.delete(
                route('clients.destroy', id),
                {
                    preserveScroll: true,
                },
            );
        }
    };

    const formatMoney = (value) => {
        return Number(value ?? 0).toLocaleString(
            'en-US',
            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            },
        );
    };

    const formatDate = (value) => {
        if (!value) {
            return '-';
        }

        return String(value).substring(0, 10);
    };

    const filteredClients = clients.filter((client) => {
        const text = [
            client.name,
            client.client_code,
            client.ip_address,
            client.phone,
            client.package?.name,
        ]
            .join(' ')
            .toLowerCase();

        const matchSearch = text.includes(
            search.toLowerCase(),
        );

        const matchFilter =
            filter === 'all'
                ? true
                : filter === 'active'
                  ? client.enabled
                  : !client.enabled;

        return matchSearch && matchFilter;
    });

    return (
        <AppLayout title="Clients">
            <Head title="Clients" />

            <div className="space-y-6">
                <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h1 className="text-3xl font-bold text-slate-800">
                            Clients
                        </h1>

                        <p className="text-slate-500">
                            Manage customers, payments and renewals
                        </p>
                    </div>

                    <Link
                        href={route('clients.create')}
                        className="rounded-lg bg-cyan-600 px-5 py-3 font-medium text-white shadow hover:bg-cyan-700"
                    >
                        + Add Client
                    </Link>
                </div>

                <div className="rounded-xl bg-white p-5 shadow">
                    <div className="grid gap-4 md:grid-cols-3">
                        <input
                            type="text"
                            placeholder="Search name, code, IP or phone..."
                            value={search}
                            onChange={(event) =>
                                setSearch(event.target.value)
                            }
                            className="rounded-lg border border-slate-300 px-4 py-3"
                        />

                        <select
                            value={filter}
                            onChange={(event) =>
                                setFilter(event.target.value)
                            }
                            className="rounded-lg border border-slate-300 px-4 py-3"
                        >
                            <option value="all">
                                All Clients
                            </option>

                            <option value="active">
                                Active
                            </option>

                            <option value="inactive">
                                Suspended
                            </option>
                        </select>

                        <div className="rounded-lg bg-slate-100 px-4 py-3">
                            Total:
                            <b className="ml-2">
                                {filteredClients.length}
                            </b>
                        </div>
                    </div>
                </div>

                <div className="overflow-x-auto rounded-xl bg-white shadow">
                    <table className="min-w-full">
                        <thead className="bg-slate-800 text-white">
                            <tr>
                                <th className="px-5 py-4 text-left">
                                    Client
                                </th>

                                <th className="px-5 py-4 text-left">
                                    IP
                                </th>

                                <th className="px-5 py-4 text-left">
                                    Package
                                </th>

                                <th className="px-5 py-4 text-left">
                                    Expiry
                                </th>

                                <th className="px-5 py-4 text-left">
                                    Status
                                </th>

                                <th className="px-5 py-4 text-left">
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            {filteredClients.length === 0 && (
                                <tr>
                                    <td
                                        colSpan="6"
                                        className="py-10 text-center text-slate-500"
                                    >
                                        No clients found
                                    </td>
                                </tr>
                            )}

                            {filteredClients.map((client) => (
                                <tr
                                    key={client.id}
                                    className="border-t hover:bg-slate-50"
                                >
                                    <td className="px-5 py-4">
                                        <Link
                                            href={route(
                                                'clients.show',
                                                client.id,
                                            )}
                                            className="font-semibold text-cyan-600 hover:underline"
                                        >
                                            {client.name}
                                        </Link>

                                        <div className="text-sm text-slate-500">
                                            {client.client_code}
                                        </div>

                                        <div className="text-sm text-slate-500">
                                            {client.router?.name ?? '-'}
                                        </div>
                                    </td>

                                    <td className="whitespace-nowrap px-5 py-4 font-mono">
                                        {client.ip_address}
                                    </td>

                                    <td className="px-5 py-4">
                                        <div className="font-medium text-slate-800">
                                            {client.package?.name ?? '-'}
                                        </div>

                                        <div className="text-sm text-slate-500">
                                            Price:{' '}
                                            {formatMoney(
                                                client.package?.price,
                                            )}
                                        </div>

                                        <div className="text-sm text-slate-500">
                                            Validity:{' '}
                                            {client.package
                                                ?.validity_days ?? 0}{' '}
                                            days
                                        </div>
                                    </td>

                                    <td className="whitespace-nowrap px-5 py-4">
                                        {formatDate(
                                            client.expiry_date,
                                        )}
                                    </td>

                                    <td className="px-5 py-4">
                                        {client.enabled ? (
                                            <span className="rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-700">
                                                Active
                                            </span>
                                        ) : (
                                            <span className="rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-700">
                                                Suspended
                                            </span>
                                        )}
                                    </td>

                                    <td className="px-5 py-4">
                                        <div className="flex min-w-[300px] flex-wrap gap-2">
                                            <button
                                                type="button"
                                                onClick={() =>
                                                    openRenewModal(
                                                        client,
                                                    )
                                                }
                                                className="rounded bg-cyan-600 px-3 py-1.5 font-medium text-white hover:bg-cyan-700"
                                            >
                                                Pay & Renew
                                            </button>

                                            <Link
                                                href={route(
                                                    'clients.edit',
                                                    client.id,
                                                )}
                                                className="rounded bg-amber-500 px-3 py-1.5 text-white hover:bg-amber-600"
                                            >
                                                Edit
                                            </Link>

                                            {client.enabled ? (
                                                <button
                                                    type="button"
                                                    onClick={() =>
                                                        suspendClient(
                                                            client.id,
                                                        )
                                                    }
                                                    className="rounded bg-red-600 px-3 py-1.5 text-white hover:bg-red-700"
                                                >
                                                    Suspend
                                                </button>
                                            ) : (
                                                <button
                                                    type="button"
                                                    onClick={() =>
                                                        activateClient(
                                                            client.id,
                                                        )
                                                    }
                                                    className="rounded bg-green-600 px-3 py-1.5 text-white hover:bg-green-700"
                                                >
                                                    Activate
                                                </button>
                                            )}

                                            <button
                                                type="button"
                                                onClick={() =>
                                                    deleteClient(
                                                        client.id,
                                                    )
                                                }
                                                className="rounded bg-slate-700 px-3 py-1.5 text-white hover:bg-slate-800"
                                            >
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            {renewClient && (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
                    <div className="w-full max-w-lg rounded-2xl bg-white shadow-2xl">
                        <div className="flex items-center justify-between border-b px-6 py-4">
                            <div>
                                <h2 className="text-xl font-bold text-slate-800">
                                    Pay & Renew
                                </h2>

                                <p className="text-sm text-slate-500">
                                    {renewClient.client_code} —{' '}
                                    {renewClient.name}
                                </p>
                            </div>

                            <button
                                type="button"
                                onClick={closeRenewModal}
                                className="rounded-lg px-3 py-2 text-xl text-slate-500 hover:bg-slate-100"
                            >
                                ×
                            </button>
                        </div>

                        <form
                            onSubmit={submitRenewal}
                            className="space-y-5 p-6"
                        >
                            <div className="grid gap-4 rounded-xl bg-slate-50 p-4 sm:grid-cols-2">
                                <div>
                                    <p className="text-sm text-slate-500">
                                        Package
                                    </p>

                                    <p className="font-bold text-slate-800">
                                        {renewClient.package
                                            ?.name ?? '-'}
                                    </p>
                                </div>

                                <div>
                                    <p className="text-sm text-slate-500">
                                        Payment Amount
                                    </p>

                                    <p className="text-xl font-bold text-green-700">
                                        {formatMoney(
                                            renewClient.package
                                                ?.price,
                                        )}
                                    </p>
                                </div>

                                <div>
                                    <p className="text-sm text-slate-500">
                                        Current Expiry
                                    </p>

                                    <p className="font-semibold text-slate-800">
                                        {formatDate(
                                            renewClient.expiry_date,
                                        )}
                                    </p>
                                </div>

                                <div>
                                    <p className="text-sm text-slate-500">
                                        Validity
                                    </p>

                                    <p className="font-semibold text-slate-800">
                                        {renewClient.package
                                            ?.validity_days ?? 0}{' '}
                                        days
                                    </p>
                                </div>
                            </div>

                            {errors.renewal && (
                                <div className="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
                                    {errors.renewal}
                                </div>
                            )}

                            <div>
                                <label className="mb-1 block font-medium text-slate-700">
                                    Payment Method
                                </label>

                                <select
                                    value={data.payment_method}
                                    onChange={(event) =>
                                        setData(
                                            'payment_method',
                                            event.target.value,
                                        )
                                    }
                                    className="w-full rounded-lg border border-slate-300 px-4 py-3"
                                >
                                    {paymentMethods.map(
                                        (method) => (
                                            <option
                                                key={method}
                                                value={method}
                                            >
                                                {method}
                                            </option>
                                        ),
                                    )}
                                </select>

                                {errors.payment_method && (
                                    <p className="mt-1 text-sm text-red-600">
                                        {
                                            errors.payment_method
                                        }
                                    </p>
                                )}
                            </div>

                            <div>
                                <label className="mb-1 block font-medium text-slate-700">
                                    Transaction ID
                                    <span className="ml-1 text-sm font-normal text-slate-400">
                                        Optional
                                    </span>
                                </label>

                                <input
                                    type="text"
                                    value={data.transaction_id}
                                    onChange={(event) =>
                                        setData(
                                            'transaction_id',
                                            event.target.value,
                                        )
                                    }
                                    placeholder="Reference or transaction number"
                                    className="w-full rounded-lg border border-slate-300 px-4 py-3"
                                />

                                {errors.transaction_id && (
                                    <p className="mt-1 text-sm text-red-600">
                                        {
                                            errors.transaction_id
                                        }
                                    </p>
                                )}
                            </div>

                            <div>
                                <label className="mb-1 block font-medium text-slate-700">
                                    Notes
                                    <span className="ml-1 text-sm font-normal text-slate-400">
                                        Optional
                                    </span>
                                </label>

                                <textarea
                                    rows="2"
                                    value={data.notes}
                                    onChange={(event) =>
                                        setData(
                                            'notes',
                                            event.target.value,
                                        )
                                    }
                                    className="w-full rounded-lg border border-slate-300 px-4 py-3"
                                />

                                {errors.notes && (
                                    <p className="mt-1 text-sm text-red-600">
                                        {errors.notes}
                                    </p>
                                )}
                            </div>

                            <div className="flex justify-end gap-3 border-t pt-5">
                                <button
                                    type="button"
                                    onClick={closeRenewModal}
                                    disabled={processing}
                                    className="rounded-lg border border-slate-300 px-5 py-2.5 font-medium text-slate-700 hover:bg-slate-50"
                                >
                                    Cancel
                                </button>

                                <button
                                    type="submit"
                                    disabled={processing}
                                    className="rounded-lg bg-cyan-600 px-5 py-2.5 font-medium text-white hover:bg-cyan-700 disabled:opacity-50"
                                >
                                    {processing
                                        ? 'Processing...'
                                        : 'Confirm Payment & Renew'}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            )}
        </AppLayout>
    );
}
