import AuthenticatedLayout from '@/Layouts/AuthenticatedLayout';
import { Head, Link, useForm } from '@inertiajs/react';

export default function Edit({ package: pkg }) {
    const { data, setData, put, processing, errors } = useForm({
        name: pkg.name ?? '',
        price: pkg.price ?? '',
        validity_days: pkg.validity_days ?? '',
        speed_download: pkg.speed_download ?? '',
        speed_upload: pkg.speed_upload ?? '',
        mikrotik_profile: pkg.mikrotik_profile ?? '',
        enabled: pkg.enabled ?? true,
    });

    const submit = (e) => {
        e.preventDefault();
        put(route('packages.update', pkg.id));
    };

    return (
        <AuthenticatedLayout
            header={
                <h2 className="text-xl font-semibold leading-tight text-gray-800">
                    Edit Package
                </h2>
            }
        >
            <Head title="Edit Package" />

            <div className="py-12">
                <div className="mx-auto max-w-4xl sm:px-6 lg:px-8">
                    <div className="rounded-lg bg-white p-6 shadow">

                        <form onSubmit={submit} className="space-y-5">

                            <div>
                                <label className="mb-1 block font-medium">
                                    Package Name
                                </label>

                                <input
                                    type="text"
                                    value={data.name}
                                    onChange={(e) => setData('name', e.target.value)}
                                    className="w-full rounded border p-2"
                                />

                                {errors.name && (
                                    <div className="text-sm text-red-600">
                                        {errors.name}
                                    </div>
                                )}
                            </div>

                            <div className="grid grid-cols-2 gap-4">

                                <div>
                                    <label className="mb-1 block font-medium">
                                        Price
                                    </label>

                                    <input
                                        type="number"
                                        value={data.price}
                                        onChange={(e) => setData('price', e.target.value)}
                                        className="w-full rounded border p-2"
                                    />
                                </div>

                                <div>
                                    <label className="mb-1 block font-medium">
                                        Validity (Days)
                                    </label>

                                    <input
                                        type="number"
                                        value={data.validity_days}
                                        onChange={(e) => setData('validity_days', e.target.value)}
                                        className="w-full rounded border p-2"
                                    />
                                </div>

                            </div>

                            <div className="grid grid-cols-2 gap-4">

                                <div>
                                    <label className="mb-1 block font-medium">
                                        Download Speed
                                    </label>

                                    <input
                                        type="text"
                                        value={data.speed_download}
                                        onChange={(e) => setData('speed_download', e.target.value)}
                                        className="w-full rounded border p-2"
                                    />
                                </div>

                                <div>
                                    <label className="mb-1 block font-medium">
                                        Upload Speed
                                    </label>

                                    <input
                                        type="text"
                                        value={data.speed_upload}
                                        onChange={(e) => setData('speed_upload', e.target.value)}
                                        className="w-full rounded border p-2"
                                    />
                                </div>

                            </div>
                            <div>
                                <label className="mb-1 block font-medium">
                                    MikroTik Profile
                                </label>

                                <input
                                    type="text"
                                    value={data.mikrotik_profile}
                                    onChange={(e) =>
                                        setData('mikrotik_profile', e.target.value)
                                    }
                                    className="w-full rounded border p-2"
                                />
                            </div>

                            <div className="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    checked={data.enabled}
                                    onChange={(e) =>
                                        setData('enabled', e.target.checked)
                                    }
                                />
                                <span>Enabled</span>
                            </div>

                            <div className="flex gap-3">
                                <button
                                    type="submit"
                                    disabled={processing}
                                    className="rounded bg-blue-600 px-5 py-2 text-white hover:bg-blue-700"
                                >
                                    Update Package
                                </button>

                                <Link
                                    href={route('packages.index')}
                                    className="rounded bg-gray-500 px-5 py-2 text-white hover:bg-gray-600"
                                >
                                    Cancel
                                </Link>
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </AuthenticatedLayout>
    );
}
