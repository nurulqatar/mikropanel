                    </div>

                    <div className="rounded-2xl bg-gradient-to-r from-green-500 to-green-600 p-6 text-white shadow-xl">
                        <div className="text-sm uppercase tracking-wide opacity-80">
                            Active Clients
                        </div>

                        <div className="mt-3 text-4xl font-bold">
                            {stats.clients.active}
                        </div>
                    </div>

                    <div className="rounded-2xl bg-gradient-to-r from-red-500 to-red-600 p-6 text-white shadow-xl">
                        <div className="text-sm uppercase tracking-wide opacity-80">
