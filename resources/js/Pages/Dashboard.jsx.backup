                    <div className="rounded-2xl bg-white p-6 shadow transition hover:-translate-y-1 hover:shadow-xl">
                        <div className="text-sm text-slate-500">
                            🌍 IP Pools
                        </div>

                        <div className="mt-3 text-3xl font-bold text-slate-800">
                            {stats.ipRanges}
                        </div>
                    </div>

                </div>

                {/* Billing */}

                <div className="grid grid-cols-1 gap-6 md:grid-cols-3">

                    <div className="rounded-2xl bg-gradient-to-r from-emerald-500 to-green-600 p-6 text-white shadow-xl">
                        <div className="text-sm uppercase opacity-80">
                            Monthly Collection
                        </div>

                        <div className="mt-3 text-3xl font-bold">
                            {stats.billing.monthlyCollection}
                        </div>
                    </div>

                    <div className="rounded-2xl bg-gradient-to-r from-blue-500 to-indigo-600 p-6 text-white shadow-xl">
                        <div className="text-sm uppercase opacity-80">
