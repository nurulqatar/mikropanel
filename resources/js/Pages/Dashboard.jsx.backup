                        </div>

                        <div className="mt-3 text-4xl font-bold">
                            {stats.clients.disabled}
                        </div>
                    </div>

                    <div className="rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 p-6 text-white shadow-xl">
                        <div className="text-sm uppercase tracking-wide opacity-80">
                            Expired
                        </div>

                        <div className="mt-3 text-4xl font-bold">
                            {stats.clients.expired}
                        </div>
                    </div>

                </div>

                {/* System */}

                <div className="grid grid-cols-1 gap-6 md:grid-cols-3">

                    <div className="rounded-2xl bg-white p-6 shadow transition hover:-translate-y-1 hover:shadow-xl">
                        <div className="text-sm text-slate-500">
                            🌐 Routers
                        </div>

                        <div className="mt-3 text-3xl font-bold text-slate-800">
                            {stats.routers}
                        </div>
                    </div>

                    <div className="rounded-2xl bg-white p-6 shadow transition hover:-translate-y-1 hover:shadow-xl">
                        <div className="text-sm text-slate-500">
                            📦 Packages
